# Local PostgreSQL connection. Create temari_net_db and apply ../database/init.sql first.
PGHOST=localhost
PGPORT=5432
PGDATABASE=temari_net_db
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable

PORT=5000
NODE_ENV=development
# Generate a fresh value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006
APP_BASE_URL=http://localhost:5000

# Leave blank to use the deterministic child-safe local answer fallback.
GEMINI_API_KEY=

# Chapa is optional. Without CHAPA_SECRET_KEY, initialization returns the branded
# local mock checkout (no funds are collected). Set the key for real Chapa payments.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Optional one-time passwords for the five accounts inserted by database/init.sql.
# Run `npm run seed:passwords` after setting these values to enable those accounts.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_ABEBE_PASSWORD=
SEED_HANNA_PASSWORD=
SEED_DAWIT_PASSWORD=
